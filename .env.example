# Modello di configurazione. Copialo in `.env` e inserisci le credenziali reali:
#
#     cp .env.example .env
#
# `.env` è ignorato da git e viene caricato automaticamente all'avvio.
# Questo file resta invece tracciato: NON scriverci mai la password vera.
#
# Struttura: postgresql://UTENTE:PASSWORD@HOST/NOME_DATABASE
QUANTUM_DATABASE_URL=postgresql://quantum_admin:LA_TUA_PASSWORD@localhost/quantum_db
